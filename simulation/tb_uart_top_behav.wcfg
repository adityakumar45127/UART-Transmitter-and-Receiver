<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_uart_top_sim.wdb" id="1">
         <top_modules>
            <top_module name="tb_uart_top" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0ns"></ZoomStartTime>
      <ZoomEndTime time="4000000ns"></ZoomEndTime>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="250"></NameColumnWidth>
      <ValueColumnWidth column_width="110"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="5" />
   <wvobject fp_name="group_clk_rst" type="group">
      <obj_property name="label">Clock &amp; Reset</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_uart_top/clk" type="logic">
         <obj_property name="ElementShortName">clk</obj_property>
         <obj_property name="ObjectShortName">clk</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/rst" type="logic">
         <obj_property name="ElementShortName">rst</obj_property>
         <obj_property name="ObjectShortName">rst</obj_property>
      </wvobject>
   </wvobject>
   <wvobject fp_name="group_baud" type="group">
      <obj_property name="label">Baud Rate Generator (9600 bps)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_uart_top/dut/sample_tick" type="logic">
         <obj_property name="ElementShortName">sample_tick</obj_property>
         <obj_property name="ObjectShortName">sample_tick</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/dut/baud_tick" type="logic">
         <obj_property name="ElementShortName">baud_tick</obj_property>
         <obj_property name="ObjectShortName">baud_tick</obj_property>
      </wvobject>
   </wvobject>
   <wvobject fp_name="group_tx" type="group">
      <obj_property name="label">UART Transmitter</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_uart_top/tx_start" type="logic">
         <obj_property name="ElementShortName">tx_start</obj_property>
         <obj_property name="ObjectShortName">tx_start</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/tx_data" type="array">
         <obj_property name="ElementShortName">tx_data[7:0]</obj_property>
         <obj_property name="ObjectShortName">tx_data[7:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/tx" type="logic">
         <obj_property name="ElementShortName">tx</obj_property>
         <obj_property name="ObjectShortName">tx</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/tx_busy" type="logic">
         <obj_property name="ElementShortName">tx_busy</obj_property>
         <obj_property name="ObjectShortName">tx_busy</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/tx_done" type="logic">
         <obj_property name="ElementShortName">tx_done</obj_property>
         <obj_property name="ObjectShortName">tx_done</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/dut/u_tx_ctrl/state" type="array">
         <obj_property name="ElementShortName">state[2:0]</obj_property>
         <obj_property name="ObjectShortName">state[2:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
   </wvobject>
   <wvobject fp_name="group_rx" type="group">
      <obj_property name="label">UART Receiver</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_uart_top/loopback_en" type="logic">
         <obj_property name="ElementShortName">loopback_en</obj_property>
         <obj_property name="ObjectShortName">loopback_en</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/rx" type="logic">
         <obj_property name="ElementShortName">rx</obj_property>
         <obj_property name="ObjectShortName">rx</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/rx_data" type="array">
         <obj_property name="ElementShortName">rx_data[7:0]</obj_property>
         <obj_property name="ObjectShortName">rx_data[7:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/rx_busy" type="logic">
         <obj_property name="ElementShortName">rx_busy</obj_property>
         <obj_property name="ObjectShortName">rx_busy</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/rx_done" type="logic">
         <obj_property name="ElementShortName">rx_done</obj_property>
         <obj_property name="ObjectShortName">rx_done</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/rx_error" type="logic">
         <obj_property name="ElementShortName">rx_error</obj_property>
         <obj_property name="ObjectShortName">rx_error</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/dut/u_rx_ctrl/state" type="array">
         <obj_property name="ElementShortName">state[1:0]</obj_property>
         <obj_property name="ObjectShortName">state[1:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
   </wvobject>
   <wvobject fp_name="group_internal" type="group">
      <obj_property name="label">Internal Shift Registers</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_uart_top/dut/u_uart_tx/tx_shift_reg" type="array">
         <obj_property name="ElementShortName">tx_shift_reg[7:0]</obj_property>
         <obj_property name="ObjectShortName">tx_shift_reg[7:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_uart_top/dut/u_uart_rx/rx_shift_reg" type="array">
         <obj_property name="ElementShortName">rx_shift_reg[7:0]</obj_property>
         <obj_property name="ObjectShortName">rx_shift_reg[7:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
      </wvobject>
   </wvobject>
</wave_config>
